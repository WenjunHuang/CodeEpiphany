<?xml version="1.0" encoding="utf-8" ?>
<idea-plugin>
    <id>com.wenjunhuang.codeepiphany</id>
    <name>Code Epiphany</name>
    <vendor>Wenjun Huang</vendor>
    <version>0.0.0</version>
    <description>Your ultimate plugin for mastering coding challenges directly in Idea platforms!</description>

    <idea-version since-build="231.0"/>

    <depends>com.intellij.modules.platform</depends>

    <resource-bundle>messages.PluginBundle</resource-bundle>
    <actions>
        <group id="CodeEpiphany.Group">
            <action id="CodeEpiphany.Actions.Refresh"
                    class="com.wenjunhuang.codeepiphany.actions.RefreshAction"
                    icon="AllIcons.Actions.Refresh"/>
            <action id="CodeEpiphany.Actions.Login"
                    class="com.wenjunhuang.codeepiphany.actions.LoginAction"
                    icon="CodeEpiphanyIcons.LOGIN"/>
            <action id="CodeEpiphany.Actions.Logout"
                    class="com.wenjunhuang.codeepiphany.actions.LogoutAction"
                    icon="CodeEpiphanyIcons.LOGOUT"/>
            <action id="CodeEpiphany.Actions.Difficulty"
                    class="com.wenjunhuang.codeepiphany.actions.DifficultyParameterAction"/>
            <action id="CodeEpiphany.Actions.Status"
                    class="com.wenjunhuang.codeepiphany.actions.StatusParameterAction"/>
            <action id="CodeEpiphany.Actions.Tags"
                    class="com.wenjunhuang.codeepiphany.actions.TagsAction"/>
            <action id="CodeEpiphany.Actions.RunCode"
                    class="com.wenjunhuang.codeepiphany.editor.actions.RunCodeAction"
                    icon="CodeEpiphanyIcons.RUN"/>
            <action id="CodeEpiphany.Actions.SubmitCode"
                    class="com.wenjunhuang.codeepiphany.editor.actions.SubmitCodeAction"
                    icon="CodeEpiphanyIcons.SUBMIT"/>
            <action id="CodeEpiphany.Actions.OpenSubmissionCode"
                    class="com.wenjunhuang.codeepiphany.actions.OpenSubmissionCodeAction"/>
            <action id="CodeEpiphany.Actions.ActivateDescriptionView"
                    class="com.wenjunhuang.codeepiphany.actions.ActivateDescriptionViewAction"
                    icon="CodeEpiphanyIcons.DESCRIPTION"/>
            <action id="CodeEpiphany.Actions.ActivateSolutionsView"
                    class="com.wenjunhuang.codeepiphany.actions.ActivateSolutionsViewAction"
                    icon="CodeEpiphanyIcons.SOLUTION"/>
            <action id="CodeEpiphany.Actions.ActivateSubmissionsView"
                    class="com.wenjunhuang.codeepiphany.actions.ActivateSubmissionsViewAction"
                    icon="CodeEpiphanyIcons.SUBMISSIONS"/>
            <action id="CodeEpiphany.Actions.SolutionSelection"
                    class="com.wenjunhuang.codeepiphany.editor.actions.SolutionSelectionAction">
            </action>
        </group>
        <group id="CodeEpiphany.HackerRank.Group">
            <action id="CodeEpiphany.Actions.HackerRank.ChangeUI"
                    class="com.wenjunhuang.codeepiphany.hackerrank.actions.ChangeChallengesUIAction"/>
            <action id="CodeEpiphany.Actions.HackerRank.Category"
                    class="com.wenjunhuang.codeepiphany.hackerrank.actions.CategoryParameterAction"/>
            <action id="CodeEpiphany.Actions.HackerRank.Skill"
                    class="com.wenjunhuang.codeepiphany.hackerrank.actions.SkillParameterAction"/>
        </group>
        <group id="CodeEpiphany.LeetCode.Group">
            <action id="CodeEpiphany.Actions.LeetCode.ChangeUI"
                    class="com.wenjunhuang.codeepiphany.leetcode.actions.LeetCodeChangeUIAction"/>
            <action id="CodeEpiphany.Actions.LeetCode.Favorite"
                    class="com.wenjunhuang.codeepiphany.leetcode.actions.FavoriteParameterAction"/>
            <action id="CodeEpiphany.Actions.LeetCode.Category"
                    class="com.wenjunhuang.codeepiphany.leetcode.actions.LeetCodeCategoryParameterAction"/>
        </group>


        <group id="CodeEpiphany.Editor.Group">
            <reference ref="CodeEpiphany.Actions.RunCode"/>
            <reference ref="CodeEpiphany.Actions.SubmitCode"/>
            <reference ref="CodeEpiphany.Actions.SolutionSelection"/>
            <reference ref="CodeEpiphany.Actions.ActivateSolutionsView"/>
            <reference ref="CodeEpiphany.Actions.ActivateDescriptionView"/>
            <reference ref="CodeEpiphany.Actions.ActivateSubmissionsView"/>
        </group>

        <group id="CodeEpiphany.ChallengeEditor.Toolbar.Group">
            <reference ref="CodeEpiphany.Actions.RunCode"/>
            <reference ref="CodeEpiphany.Actions.SubmitCode"/>
            <reference ref="CodeEpiphany.Actions.SolutionSelection"/>
            <reference ref="CodeEpiphany.Actions.ActivateSolutionsView"/>
            <reference ref="CodeEpiphany.Actions.ActivateDescriptionView"/>
            <reference ref="CodeEpiphany.Actions.ActivateSubmissionsView"/>
        </group>

        <group id="CodeEpiphany.Editor.Menu" class="com.wenjunhuang.codeepiphany.editor.actions.EditorMenuActionGroup"
               popup="true">
            <reference ref="CodeEpiphany.Editor.Group"/>
            <add-to-group group-id="EditorPopupMenu" anchor="first"/>
        </group>


        <group id="CodeEpiphany.Dojos.Actions.OpenChallengeGroup"
               popup="true"
               class="com.wenjunhuang.codeepiphany.actions.OpenChallengeActionGroup"/>

        <group id="CodeEpiphany.Dojos.HackerRank.Toolbar">
            <reference ref="CodeEpiphany.Actions.HackerRank.Category"/>
            <reference ref="CodeEpiphany.Actions.Difficulty"/>
            <reference ref="CodeEpiphany.Actions.Status"/>
            <reference ref="CodeEpiphany.Actions.HackerRank.Skill"/>
            <reference ref="CodeEpiphany.Actions.Tags"/>
            <reference ref="CodeEpiphany.Actions.Refresh"/>
        </group>

        <group id="CodeEpiphany.Dojos.LeetCode.Toolbar">
            <reference ref="CodeEpiphany.Actions.LeetCode.Category"/>
            <reference ref="CodeEpiphany.Actions.LeetCode.Favorite"/>
            <reference ref="CodeEpiphany.Actions.Difficulty"/>
            <reference ref="CodeEpiphany.Actions.Status"/>
            <reference ref="CodeEpiphany.Actions.Tags"/>
            <reference ref="CodeEpiphany.Actions.Refresh"/>
        </group>

        <group id="CodeEpiphany.Dojos.TitleToolbar">
            <reference ref="CodeEpiphany.Actions.Login"/>
            <reference ref="CodeEpiphany.Actions.Logout"/>
        </group>
        <group id="CodeEpiphany.Dojos.TitleToolbar.HackerRank">
            <reference ref="CodeEpiphany.Actions.HackerRank.ChangeUI"/>
        </group>
        <group id="CodeEpiphany.Dojos.TitleToolbar.LeetCode">
            <reference ref="CodeEpiphany.Actions.LeetCode.ChangeUI"/>
        </group>

        <group id="CodeEpiphany.Dojos.ChallengesTable.Popupmenu">
            <reference ref="CodeEpiphany.Dojos.Actions.OpenChallengeGroup"/>
        </group>

        <group id="CodeEpiphany.Sidebar">
            <action id="CodeEpiphany.Sidebar.Actions.ZoomIn"
                    class="com.wenjunhuang.codeepiphany.toolwindows.sidebar.description.actions.ZoomInAction"
                    icon="AllIcons.General.ZoomIn"/>
            <action id="CodeEpiphany.Sidebar.Actions.ZoomOut"
                    class="com.wenjunhuang.codeepiphany.toolwindows.sidebar.description.actions.ZoomOutAction"
                    icon="AllIcons.General.ZoomOut"/>
            <action id="CodeEpiphany.Sidebar.Actions.ActualZoom"
                    class="com.wenjunhuang.codeepiphany.toolwindows.sidebar.description.actions.ActualZoomAction"
                    icon="AllIcons.General.ActualZoom"/>
        </group>

        <group id="CodeEpiphany.Sidebar.Description.Toolbar">
            <reference ref="CodeEpiphany.Sidebar.Actions.ZoomIn"/>
            <reference ref="CodeEpiphany.Sidebar.Actions.ZoomOut"/>
            <reference ref="CodeEpiphany.Sidebar.Actions.ActualZoom"/>
        </group>
        <group id="CodeEpiphany.Sidebar.Description.PopupMenu">
            <reference ref="$Copy"/>
            <separator/>
            <reference ref="FindUsages"/>
            <separator/>
            <reference ref="CodeEpiphany.Sidebar.Description.Toolbar"/>
        </group>

        <group id="CodeEpiphany.Sidebar.SubmissionLog.Toolbar.Group">
            <action class="com.wenjunhuang.codeepiphany.actions.CodeDojoParameterAction"
                    id="CodeEpiphany.Sidebar.SubmissionLog.Actions.CodeDojo"/>
            <action class="com.wenjunhuang.codeepiphany.actions.LanguageParameterAction"
                    id="CodeEpiphany.Sidebar.SubmissionLog.Actions.Language"/>
            <reference ref="CodeEpiphany.Actions.Refresh"/>
        </group>

        <group id="CodeEpiphany.Sidebar.SubmissionsTable.Popupmenu">
            <reference ref="CodeEpiphany.Actions.OpenSubmissionCode"/>
            <reference ref="CompareTwoFiles"/>
            <reference ref="CompareFileWithEditor"/>
        </group>
    </actions>


    <extensions defaultExtensionNs="com.intellij">
        <notificationGroup displayType="BALLOON" id="My Plugin Notification"/>
        <toolWindow factoryClass="com.wenjunhuang.codeepiphany.toolwindows.sidebar.SidebarWindowFactory"
                    id="CodeEpiphany Sidebar"
                    secondary="false"
                    anchor="bottom"
                    icon="CodeEpiphanyIcons.PLUGIN"/>
        <toolWindow factoryClass="com.wenjunhuang.codeepiphany.toolwindows.dojo.CodeDojoToolWindowFactory"
                    icon="CodeEpiphanyIcons.PLUGIN"
                    id="CodeEpiphany CodeDojos" anchor="left"/>

        <registryKey defaultValue="false" description="Enable debug" key="codeepiphany.debug"/>

        <projectConfigurable parentId="tools"
                             displayName="Code Epiphany"
                             id="CodeEpiphany.Settings"
                             instance="com.wenjunhuang.codeepiphany.settings.CodeEpiphanySettingsConfigurable">
            <configurable id="CodeEpiphany.Settings.LeetCodeCN"
                          instance="com.wenjunhuang.codeepiphany.leetcode.settings.LeetCodeCNSettingsConfigurable"
                          key="leetcodecn.settings.displayName"/>
            <configurable id="CodeEpiphany.Settings.LeetCode"
                          instance="com.wenjunhuang.codeepiphany.leetcode.settings.LeetCodeSettingsConfigurable"
                          key="leetcode.settings.displayName"/>
            <configurable
                    id="CodeEpiphany.Settings.HackerRank"
                    instance="com.wenjunhuang.codeepiphany.hackerrank.settings.HackerRankSettingsConfigurable"
                    key="hackerrank.settings.displayName"/>
        </projectConfigurable>

        <lang.foldingBuilder language="JAVA"
                             implementationClass="com.wenjunhuang.codeepiphany.editor.extensions.SubmissionRegionFoldingBuilder"/>
        <lang.foldingBuilder language="Kotlin"
                             implementationClass="com.wenjunhuang.codeepiphany.editor.extensions.SubmissionRegionFoldingBuilder"/>
        <lang.foldingBuilder language="Scala"
                             implementationClass="com.wenjunhuang.codeepiphany.editor.extensions.SubmissionRegionFoldingBuilder"/>
        <lang.foldingBuilder language="Dart"
                             implementationClass="com.wenjunhuang.codeepiphany.editor.extensions.SubmissionRegionFoldingBuilder"/>
        <lang.foldingBuilder language="Haskell"
                             implementationClass="com.wenjunhuang.codeepiphany.editor.extensions.SubmissionRegionFoldingBuilder"/>
        <lang.foldingBuilder language="Python"
                             implementationClass="com.wenjunhuang.codeepiphany.editor.extensions.SubmissionRegionFoldingBuilder"/>
        <lang.foldingBuilder language="JavaScript"
                             implementationClass="com.wenjunhuang.codeepiphany.editor.extensions.SubmissionRegionFoldingBuilder"/>
        <lang.foldingBuilder language="TypeScript"
                             implementationClass="com.wenjunhuang.codeepiphany.editor.extensions.SubmissionRegionFoldingBuilder"/>
        <lang.foldingBuilder language="ObjectiveC"
                             implementationClass="com.wenjunhuang.codeepiphany.editor.extensions.SubmissionRegionFoldingBuilder"/>
        <lang.foldingBuilder language="C++"
                             implementationClass="com.wenjunhuang.codeepiphany.editor.extensions.SubmissionRegionFoldingBuilder"/>
        <lang.foldingBuilder language="C"
                             implementationClass="com.wenjunhuang.codeepiphany.editor.extensions.SubmissionRegionFoldingBuilder"/>
        <lang.foldingBuilder language="C#"
                             implementationClass="com.wenjunhuang.codeepiphany.editor.extensions.SubmissionRegionFoldingBuilder"/>
        <lang.foldingBuilder language="Rust"
                             implementationClass="com.wenjunhuang.codeepiphany.editor.extensions.SubmissionRegionFoldingBuilder"/>
        <lang.foldingBuilder language="go"
                             implementationClass="com.wenjunhuang.codeepiphany.editor.extensions.SubmissionRegionFoldingBuilder"/>
        <lang.foldingBuilder language="Python"
                             implementationClass="com.wenjunhuang.codeepiphany.editor.extensions.SubmissionRegionFoldingBuilder"/>
        <lang.foldingBuilder language="PHP"
                             implementationClass="com.wenjunhuang.codeepiphany.editor.extensions.SubmissionRegionFoldingBuilder"/>
        <fileIconPatcher implementation="com.wenjunhuang.codeepiphany.editor.extensions.ChallengeEditorIconProvider"
                         order="last"/>
        <editorTabTitleProvider
                implementation="com.wenjunhuang.codeepiphany.editor.extensions.ChallengeEditorTabTitleProvider"
                order="last"/>
        <fileEditorProvider
                id="CodeEpiphany.EditorProvider"
                implementation="com.wenjunhuang.codeepiphany.editor.extensions.ChallengeEditorProvider"/>
        <fileEditorProvider id="CodeEpiphany.SubmissionCodeEditorProvider"
                            implementation="com.wenjunhuang.codeepiphany.vfs.SubmissionCodeEditorProvider"/>
        <vfs.asyncListener implementation="com.wenjunhuang.codeepiphany.editor.extensions.ChallengeFileRenameListener"/>
        <virtualFileSystem key="submission-code"
                           physical="false"
                           implementationClass="com.wenjunhuang.codeepiphany.vfs.SubmissionCodeFileSystem"/>
        <virtualFileSystem key="solution-remark"
                           physical="false"
                           implementationClass="com.wenjunhuang.codeepiphany.vfs.SolutionRemarkFileSystem"/>
    </extensions>
</idea-plugin>