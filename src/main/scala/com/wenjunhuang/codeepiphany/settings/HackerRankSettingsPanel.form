          <hspacer id="abd5d">
            <constraints border-constraint="Center"/>
          </hspacer>
          <component id="1a1e5" class="com.intellij.openapi.actionSystem.impl.ActionToolbarImpl" binding="myCodeTemplateToolbar" custom-create="true">
            <constraints border-constraint="East"/>
            <properties/>
          </component>
        </children>
      </grid>
      <grid id="f7c18" class="com.intellij.openapi.ui.Splitter" binding="myCodeTemplateSplitter" custom-create="true" layout-manager="GridLayoutManager" row-count="1" column-count="1" same-size-horizontally="false" same-size-vertically="false" hgap="-1" vgap="-1">
        <margin top="0" left="0" bottom="0" right="0"/>
        <constraints>
          <grid row="5" column="0" row-span="1" col-span="2" vsize-policy="0" hsize-policy="3" anchor="0" fill="1" indent="0" use-parent-layout="false">
            <preferred-size width="-1" height="300"/>
          </grid>
        </constraints>
        <properties/>
        <border type="none"/>
        <children/>
      </grid>
    </children>
