<?xml version="1.0" encoding="utf-8" ?>
<idea-plugin>
    <id>com.wenjunhuang.codeepiphany</id>
    <name>Code Epiphany</name>
    <version>0.0.1</version>
    <vendor>Huang wenjun</vendor>
    <description>
        <![CDATA[Your ultimate plugin for mastering coding challenges directly in Idea platforms!]]></description>

    <idea-version since-build="231.0"/>

    <depends>com.intellij.modules.platform</depends>
    <depends>com.intellij.properties</depends>

    <resource-bundle>messages.PluginBundle</resource-bundle>
    <actions>
        <group id="CodeEpiphany.Dojos">
            <action id="CodeEpiphany.Dojos.Actions.Login"
                    class="com.wenjunhuang.codeepiphany.toolwindows.dojo.actions.LoginAction"
                    icon="CodeEpiphanyIcons.LOGIN_ICON"/>
            <action id="CodeEpiphany.Dojos.Actions.Logout"
                    class="com.wenjunhuang.codeepiphany.toolwindows.dojo.actions.LogoutAction"
                    icon="CodeEpiphanyIcons.LOGOUT_ICON"/>
            <action id="CodeEpiphany.Dojos.Actions.SwitchUI"
                    class="com.wenjunhuang.codeepiphany.toolwindows.dojo.actions.SwitchUIAction">
            </action>
            <action id="CodeEpiphany.Dojos.Actions.Lists"
                    class="com.wenjunhuang.codeepiphany.toolwindows.dojo.actions.ListsAction"/>
            <action id="CodeEpiphany.Dojos.Actions.Difficulty"
                    class="com.wenjunhuang.codeepiphany.toolwindows.dojo.actions.DifficultyAction"/>
            <action id="CodeEpiphany.Dojos.Actions.Status"
                    class="com.wenjunhuang.codeepiphany.toolwindows.dojo.actions.StatusAction"/>
            <action id="CodeEpiphany.Dojos.Actions.Skill"
                    class="com.wenjunhuang.codeepiphany.toolwindows.dojo.actions.SkillAction"/>
            <action id="CodeEpiphany.Dojos.Actions.Tags"
                    class="com.wenjunhuang.codeepiphany.toolwindows.dojo.actions.TagsAction"/>
            <action id="CodeEpiphany.Dojos.Actions.OpenChallenge"
                    class="com.wenjunhuang.codeepiphany.toolwindows.dojo.actions.OpenChallengeAction"/>
        </group>

        <group id="CodeEpiphany.Dojos.Hackerrank.Toolbar">
            <reference ref="CodeEpiphany.Dojos.Actions.Lists"/>
            <reference ref="CodeEpiphany.Dojos.Actions.Difficulty"/>
            <reference ref="CodeEpiphany.Dojos.Actions.Status"/>
            <reference ref="CodeEpiphany.Dojos.Actions.Skill"/>
            <reference ref="CodeEpiphany.Dojos.Actions.Tags"/>
        </group>
        <group id="CodeEpiphany.Dojos.TitleToolbar">
            <reference ref="CodeEpiphany.Dojos.Actions.SwitchUI"/>
            <reference ref="CodeEpiphany.Dojos.Actions.Login"/>
            <reference ref="CodeEpiphany.Dojos.Actions.Logout"/>
        </group>
        <group id="CodeEpiphany.Dojos.ChallengesTable.Popupmenu">
            <reference ref="CodeEpiphany.Dojos.Actions.OpenChallenge"/>
        </group>

        <group id="CodeEpiphany.Sidebar">
            <action id="CodeEpiphany.Sidebar.Actions.ZoomIn"
                    class="com.wenjunhuang.codeepiphany.toolwindows.sidebar.actions.ZoomInAction"
                    icon="AllIcons.General.ZoomIn"/>
            <action id="CodeEpiphany.Sidebar.Actions.ZoomOut"
                    class="com.wenjunhuang.codeepiphany.toolwindows.sidebar.actions.ZoomOutAction"
                    icon="AllIcons.General.ZoomOut"/>
            <action id="CodeEpiphany.Sidebar.Actions.ActualZoom"
                    class="com.wenjunhuang.codeepiphany.toolwindows.sidebar.actions.ActualZoomAction"
                    icon="AllIcons.General.ActualZoom"/>
        </group>

        <group id="CodeEpiphany.Sidebar.Description.Toolbar">
            <reference ref="CodeEpiphany.Sidebar.Actions.ZoomIn"/>
            <reference ref="CodeEpiphany.Sidebar.Actions.ZoomOut"/>
            <reference ref="CodeEpiphany.Sidebar.Actions.ActualZoom"/>
        </group>
        <group id="CodeEpiphany.Sidebar.Description.PopupMenu">
            <reference ref="$Copy"/>
            <separator/>
            <reference ref="FindUsages"/>
            <separator/>
            <reference ref="CodeEpiphany.Sidebar.Description.Toolbar"/>
        </group>

        <!-- test -->
        <action id="com.wenjunhuang.codeepiphany.test.actions.ShowLoginDialogAction"
                class="com.wenjunhuang.codeepiphany.test.actions.ShowLoginDialogAction" text="Show Login Dialog"
                description="Show Login Dialog">
            <add-to-group group-id="ToolsMenu" anchor="first"/>
        </action>
    </actions>

    <applicationListeners>
        <listener class="com.wenjunhuang.codeepiphany.toolwindows.sidebar.ChallengeCodeFileEditorListener"
                  topic="com.intellij.openapi.fileEditor.FileEditorManagerListener"/>

    </applicationListeners>

    <extensions defaultExtensionNs="com.intellij">
        <notificationGroup displayType="BALLOON" id="My Plugin Notification"/>
        <toolWindow factoryClass="com.wenjunhuang.codeepiphany.toolwindows.sidebar.SidebarWindowFactory"
                    id="CodeEpiphany Sidebar" anchor="bottom"
                    icon="CodeEpiphanyIcons.LOGIN_ICON"/>
        <toolWindow factoryClass="com.wenjunhuang.codeepiphany.toolwindows.dojo.CodeDojoToolWindowFactory"
                    id="CodeEpiphany Dojos" anchor="left"/>

        <registryKey defaultValue="false" description="Enable debug" key="codeepiphany.debug"/>

        <projectConfigurable parentId="tools"
                             displayName="Code Epiphany"
                             id="CodeEpiphany.Settings"
                             instance="com.wenjunhuang.codeepiphany.CodeEpiphanyConfigurable">
            <configurable
                    id="CodeEpiphany.Settings.HackerRank"
                    instance="com.wenjunhuang.codeepiphany.hackerrank.settings.HackerRankSettingsConfigurable"
                    key="hackerrank.settings.title"/>
        </projectConfigurable>
    </extensions>


</idea-plugin>