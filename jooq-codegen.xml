<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<configuration>
    <!-- Configure the database connection here -->
    <jdbc>
        <driver>org.sqlite.JDBC</driver>
        <url>jdbc:sqlite:./database/designv2.sqlite</url>
    </jdbc>
    <generator>

        <database>
            <name>org.jooq.meta.sqlite.SQLiteDatabase</name>
            <includes>.*</includes>
            <excludes>.*?_(config|data|docsize|idx)</excludes>
            <outputSchemaToDefault>true</outputSchemaToDefault>
            <includeSystemTables>false</includeSystemTables>
            <forcedTypes>
                <forcedType>
                    <name>LOCALDATETIME</name>
                    <includeExpression>.*DateTime</includeExpression>
                </forcedType>
                <forcedType>
                    <name>BIGINT</name>
                    <includeExpression>.*Id</includeExpression>
                    <includeExpression>id</includeExpression>
                    <types>INTEGER</types>
                </forcedType>
            </forcedTypes>
        </database>

        <generate>
            <javaTimeTypes>true</javaTimeTypes>
            <relations>true</relations>
            <deprecated>false</deprecated>
            <generatedAnnotation>false</generatedAnnotation>
            <records>true</records>
            <pojos>false</pojos>
            <interfaces>false</interfaces>
            <daos>false</daos>
            <jpaAnnotations>false</jpaAnnotations>
            <validationAnnotations>false</validationAnnotations>
            <globalObjectReferences>true</globalObjectReferences>
            <fluentSetters>true</fluentSetters>
        </generate>

        <target>
            <packageName>com.wenjunhuang.codeepiphany.database</packageName>
        </target>
    </generator>
</configuration>
